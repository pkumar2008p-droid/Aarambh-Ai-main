# Local development only. Copy to .env and replace every placeholder.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATA_KEY=GENERATE_A_FERNET_KEY
PEPPER=GENERATE_A_LONG_RANDOM_SECRET
APP_ENV=development
DB_CONNECT_TIMEOUT=10
FRONTEND_ORIGINS=http://localhost:5173
COOKIE_SAMESITE=Lax

# Optional integrations
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=your-enabled-anthropic-model-id
HOSPITAL_LAT=30.9097
HOSPITAL_LNG=75.8527

# Only for an isolated synthetic-data demo; never use with real patient accounts.
ALLOW_DEMO_OTP=false
DEMO_OTP=
